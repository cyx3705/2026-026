  },
  "project": {
    "id": "2026-026",
    "name": "HistoryAurora",
    "title": "HistoryAurora 前端应用",
    "kind": [
      "software",
      "tooling",
      "appshell-module"
    ],
    "status": "active",
    "version": "2.2.9",
    "branch": "main"
  },
  "paths": {
    "activeRoots": [
      "b-Code-Web",
      "b-Code-Shell",
      "b-Code-Studio",
      "b-Code-Verify",
      "b-Office"
    ],
    "sourceRoots": [
      "b-Code-Web",
      "b-Code-Shell",
      "b-Code-Studio",
      "b-Code-Verify"
    ],
    "generatedRoots": [
      "b-Code-Web/bin",
      "b-Code-Web/obj",
      "b-Code-Shell/**/bin",
      "b-Code-Shell/**/obj",
      "b-Code-Studio/**/bin",
      "b-Code-Studio/**/obj",
      "b-Code-Verify/**/bin",
      "b-Code-Verify/**/obj",
      "z-Publish"
    ],
    "archiveRoots": [
      "z-Publish/history"
    ],
    "releaseRoots": [
      "z-Publish"
    ],
    "allowedRootDirectoryPrefixes": [
      "a-",
      "b-",
      "z-"
    ]
  },
  "documents": {
    "conventions": "b-Office/现行约定.md"
  },
  "commands": {
    "syncColors": "node b-Code-Studio/eng/sync-colors.mjs",
    "checkColors": "node b-Code-Studio/eng/sync-colors.mjs --check",
    "syncTypography": "node b-Code-Studio/eng/sync-typography.mjs",
    "checkTypography": "node b-Code-Studio/eng/sync-typography.mjs --check",
    "setup": "dotnet restore .\\HistoryAurora.sln --locked-mode -p:NuGetAudit=false",
    "build": "dotnet build .\\HistoryAurora.sln -c Release --no-restore -p:NuGetAudit=false",
    "test": "dotnet test .\\b-Code-Verify\\Contracts\\Contracts.csproj -c Release -p:NuGetAudit=false",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\b-Code-Studio\\eng\\Test-QualityGate.ps1",
    "run": "dotnet run --project b-Code-Web/HistoryAurora.Web.csproj",
    "testWeb": "node --test b-Code-Verify/Web/typography.test.mjs b-Code-Verify/Web/protocol.test.mjs b-Code-Verify/Web/registration.test.mjs b-Code-Verify/Web/page-tree.test.mjs b-Code-Verify/Web/layout.test.mjs b-Code-Verify/Web/workspace-state.test.mjs b-Code-Verify/Web/selection.test.mjs b-Code-Verify/Web/table.test.mjs b-Code-Verify/Web/table-data.test.mjs b-Code-Verify/Web/panel.test.mjs b-Code-Verify/Web/panel-files.test.mjs b-Code-Verify/Web/console.test.mjs b-Code-Verify/Web/catalog.test.mjs b-Code-Verify/Web/float.test.mjs b-Code-Verify/Web/chat.test.mjs b-Code-Verify/Web/dialog.test.mjs b-Code-Verify/Web/frontend-link.test.mjs b-Code-Verify/Web/shell-chrome.test.mjs b-Code-Verify/Web/colors.test.mjs",
    "testWebBrowser": "node --test --test-concurrency=4 b-Code-Verify/Web/browser.test.mjs b-Code-Verify/Web/*-browser.test.mjs",
    "buildShellWindows": "dotnet publish b-Code-Shell/AuroraShell/AuroraShell.csproj -f net9.0-windows10.0.19041.0 -c Release -p:NuGetAudit=false",
    "buildShellAndroid": "dotnet publish b-Code-Shell/AuroraShell/AuroraShell.csproj -f net9.0-android -c Release -p:NuGetAudit=false",
    "package": "HistoryVulcan.Cli.exe --cli vulcan.dev.submit worktree=<工作区>"
  },
  "externalDependencies": [
    "OneHistorySite/z-OneHistoryID/colors.json (WEB-COLOR-001): acquired with diana.z.read by syncColors; validated offline snapshots ship with the program",
    "OneHistorySite/z-OneHistoryID/typography.json (WEB-FONT-002): acquired with diana.z.read by commands.syncTypography; generated snapshots are included for offline builds and runtime; Node.js >= 20 and a live Aurora/Diana command bridge are needed only for syncTypography/checkTypography",
    "Bundled Noto Serif Variable Latin font from @fontsource-variable/noto-serif 5.3.0 (SIL OFL 1.1); font and license in b-Code-Web/wwwroot, embedded for offline use",
    "Node.js >= 20 for Web protocol tests",
    "Shell only (b-Code-Shell): .NET 9 SDK with maui-windows and maui-android workloads, Android SDK and JDK 17; not needed by the module pipeline",
    "Optional browser validation: Playwright available to Node through NODE_PATH; installed Microsoft Edge by default (AURORA_BROWSER_CHANNEL overrides)",
    "HistoryVulcan >= 8.0.2 host snapshot from ../2026-023-HistoryVulcan/z-Publish/host",
    ".NET 8 SDK, Windows Desktop Runtime and ASP.NET Core 8 runtime (Aurora Web runs as a child process of the module)"
  ],
  "contextExclusions": [
    "z-Publish/**",
    "**/bin/**",
    "**/obj/**",
    "**/node_modules/**",
    "**/.vs/**",
    "artifacts/**"
  ],
  "publish": {
    "versionProps": "b-Code-Studio\\AuroraVersion.props",
    "versionProperty": "HistoryAuroraVersion",
    "sourceManifest": "b-Code-Studio\\Module\\module.manifest.json",
    "package": {
      "project": "b-Code-Studio\\Module\\HistoryAurora.Module.csproj",
      "files": [
        "HistoryAurora.dll",
        "HistoryAurora.xml",
        "module.manifest.json",
        "web/HistoryAurora.Web.dll",
        "web/HistoryAurora.Web.exe",
        "web/HistoryAurora.Web.deps.json",
        "web/HistoryAurora.Web.runtimeconfig.json"
      ]
    },
    "validation": [
      {
        "tool": "dotnet.exe",
        "configurations": [
          "Release"
        ],
        "arguments": [
          "test",
          "b-Code-Verify\\ModuleSmoke\\ModuleSmoke.csproj",
          "-c",
          "{configuration}",
          "-p:NuGetAudit=false"
        ],
        "description": "Run module smoke ({configuration})"
      },
      {
        "tool": "dotnet.exe",
        "configurations": [
          "Release"
        ],
        "arguments": [
          "test",
          "b-Code-Verify\\Contracts\\Contracts.csproj",
          "-c",
          "{configuration}",
          "-p:NuGetAudit=false"
        ],
        "description": "Run module contracts ({configuration})"
      }
    ]
  }
}
