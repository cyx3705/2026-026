  "commands": {
    "setup": "dotnet restore .\\HistoryAurora.sln --locked-mode -p:NuGetAudit=false",
    "build": "dotnet build .\\HistoryAurora.sln -c Release --no-restore -p:NuGetAudit=false",
    "test": "dotnet test .\\b-Code-Verify\\Contracts\\Contracts.csproj -c Release -p:NuGetAudit=false",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\b-Code-Studio\\eng\\Test-QualityGate.ps1",
    "run": null,
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\b-Code-Studio\\eng\\Build-HistoryAuroraPackage.ps1"
  },
  "externalDependencies": [
    "HistoryVulcan >= 5.4.0 host snapshot from ../2026-023-HistoryVulcan/z-Publish/host",
    ".NET 8 SDK and Windows Desktop Runtime",
    "Dirkster.AvalonDock 4.72.1 (must match the host pin; unpinned resolves to a .NET Framework build)",
    "Dirkster.AvalonDock.Themes.VS2013 4.72.1"
  ],
  "contextExclusions": [
    "z-Publish/**",
    "**/bin/**",
    "**/obj/**",
    "**/node_modules/**",
    "**/.vs/**",
    "artifacts/**"
  ],
  "publish": {
    "versionProps": "b-Code-Studio\\AuroraVersion.props",
