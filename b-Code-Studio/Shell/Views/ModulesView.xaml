<UserControl x:Class="HistoryAurora.Shell.Views.ModulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- 视图是独立 BAML:StaticResource 必须在自己的作用域里找得到 -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HistoryAurora;component/Themes/AuroraControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RefreshButton" Content="刷新模块" Click="OnReloadClick" />
            <Button x:Name="HotReloadButton" Content="热重载" Margin="8,0,0,0" Click="OnHotReloadClick" />
            <Button x:Name="OpenDirButton" Content="打开发现根" Margin="8,0,0,0" Click="OnOpenDirClick" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Foreground="{DynamicResource Aurora.Brush.TextSecondary}" Margin="0,6,0,0"
                   Text="模块来自 %AppData%\HistoryVulcan\Modules；热重载安装候选或历史包" />

        <!--
            REQ-UI-007：表格一律由 AuroraTable 承担，本页只提供数据与列宽。
            列在 ModulesView.xaml.cs 里声明——列宽属于数据形状，而列的取值是强类型委托，
            写在代码里比写成 Binding 字符串更早发现错。
        -->
        <ContentControl x:Name="TableHost" />
    </DockPanel>
</UserControl>
