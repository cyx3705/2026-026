<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Aurora.Dialog.*：嵌入主窗体的弹窗卡片（REQ-UI-136，1.30.0）。
        卡片与停靠区的页面卡片同一个长相：Surface 底、Aurora.Radius.Page 圆角（「块用圆角」）；
        标题用页面里的段标题 + 墨色条（Aurora.Heading.*），不再有标题栏与关闭键。
        本字典由主窗体合并（遮罩要用），单独构造的卡片（测试）自己合并，见 AuroraDialogView。
    -->

    <Style x:Key="Aurora.Dialog.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aurora.Brush.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Aurora.Radius.Page}" />
        <Setter Property="Padding" Value="20,16,20,16" />
        <Setter Property="Effect" Value="{DynamicResource Aurora.Shadow.Flyout}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
    </Style>

    <!-- 遮罩：画布色压暗后面的页面，深浅主题各取各的画布，不写死黑色 -->
    <Style x:Key="Aurora.Dialog.Scrim" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Canvas}" />
        <Setter Property="Opacity" Value="0.72" />
    </Style>

    <Style x:Key="Aurora.Dialog.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Aurora.Dialog.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Aurora.Dialog.Countdown" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextSecondary}" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <Style x:Key="Aurora.Dialog.Footer" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,16,0,0" />
    </Style>

    <Style x:Key="Aurora.Dialog.Content" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.MonoFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Mono}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aurora.Brush.ControlBorder}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="7,3" />
    </Style>

    <Style x:Key="Aurora.Dialog.Prompt" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aurora.Brush.ControlBorder}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{DynamicResource Aurora.Size.Control}" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Padding" Value="7,3" />
    </Style>
</ResourceDictionary>
