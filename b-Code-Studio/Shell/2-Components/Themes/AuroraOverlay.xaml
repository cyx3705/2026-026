<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonDockControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
    xmlns:reskeys="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        The ContentControl instances below are AvalonDock's hit rectangles. Their
        size must never be inherited from the artwork they contain: OverlayWindow
        uses the containing grids for the detection rectangles and the controls for
        the edge targets. The indicator template is deliberately clipped to 28 DIP.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AvalonDock.Themes.VS2013;component/OverlayButtons.xaml" />
        <ResourceDictionary Source="/AvalonDock.Themes.VS2013;component/Themes/Icons/IconGeometry.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Preserve Aurora's public theme token values; the custom template uses
         literal hit-target dimensions so this compatibility value cannot resize it. -->
    <sys:Double x:Key="{x:Static reskeys:ResourceKeys.DockingButtonWidthKey}">28</sys:Double>
    <sys:Double x:Key="{x:Static reskeys:ResourceKeys.DockingButtonHeightKey}">28</sys:Double>

    <DataTemplate x:Key="AuroraOverlayIndicatorTemplate">
        <Border Width="28"
                Height="28"
                ClipToBounds="True"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <ContentPresenter Content="{Binding}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              IsHitTestVisible="False" />
        </Border>
    </DataTemplate>

    <Style x:Key="AuroraOverlayHitTarget" TargetType="ContentControl">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ContentTemplate" Value="{StaticResource AuroraOverlayIndicatorTemplate}" />
    </Style>

    <Style x:Key="{x:Type avalonDockControls:OverlayWindow}"
           TargetType="{x:Type avalonDockControls:OverlayWindow}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalonDockControls:OverlayWindow}">
                    <Canvas x:Name="PART_DropTargetsContainer" Opacity="0.9">
                        <Path x:Name="PART_PreviewBox"
                              Fill="Transparent"
                              Stroke="{DynamicResource {x:Static reskeys:ResourceKeys.PreviewBoxBorderBrushKey}}"
                              StrokeThickness="0.5"
                              IsHitTestVisible="False" />

                        <Grid x:Name="PART_DockingManagerDropTargets">
                            <ContentControl x:Name="PART_DockingManagerDropTargetLeft"
                                            Style="{StaticResource AuroraOverlayHitTarget}"
                                            Margin="10"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Content="{StaticResource DockAnchorableLeft}" />
                            <ContentControl x:Name="PART_DockingManagerDropTargetRight"
                                            Style="{StaticResource AuroraOverlayHitTarget}"
                                            Margin="10"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Content="{StaticResource DockAnchorableRight}" />
                            <ContentControl x:Name="PART_DockingManagerDropTargetBottom"
                                            Style="{StaticResource AuroraOverlayHitTarget}"
                                            Margin="10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Content="{StaticResource DockAnchorableBottom}" />
                            <ContentControl x:Name="PART_DockingManagerDropTargetTop"
                                            Style="{StaticResource AuroraOverlayHitTarget}"
                                            Margin="10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Content="{StaticResource DockAnchorableTop}" />
                        </Grid>

                        <Grid x:Name="PART_AnchorablePaneDropTargets">
                            <Path Width="122"
                                  Height="122"
                                  Data="{DynamicResource DockPaneEmpty}"
                                  Fill="{DynamicResource {x:Static reskeys:ResourceKeys.DockingButtonStarBackgroundBrushKey}}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource {x:Static reskeys:ResourceKeys.DockingButtonStarBorderBrushKey}}"
                                  StrokeThickness="1"
                                  IsHitTestVisible="False" />
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <ContentControl x:Name="PART_AnchorablePaneDropTargetTop" Grid.Row="0" Grid.Column="1" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentAsAnchorableTop}" />
                                <ContentControl x:Name="PART_AnchorablePaneDropTargetRight" Grid.Row="1" Grid.Column="2" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentAsAnchorableRight}" />
                                <ContentControl x:Name="PART_AnchorablePaneDropTargetBottom" Grid.Row="2" Grid.Column="1" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentAsAnchorableBottom}" />
                                <ContentControl x:Name="PART_AnchorablePaneDropTargetLeft" Grid.Row="1" Grid.Column="0" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentAsAnchorableLeft}" />
                                <ContentControl x:Name="PART_AnchorablePaneDropTargetInto" Grid.Row="1" Grid.Column="1" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentInside}" />
                            </Grid>
                        </Grid>

                        <!--
                            REQ-UI-078:中央区不分栏。把中央页丢到中央区的上/下/左/右会让
                            AvalonDock 就地拆出第二个文档区,那个形态在本壳里是坏的
                            (主区认定错位、新窗格选不中内容),因此这四个方位的落点整片折叠。
                            **元素本身必须留着**:AvalonDock 的 OverlayWindow 按名字
                            GetTemplateChild 这些 PART,删掉会在它内部空引用。折叠之后
                            它们的屏幕矩形是空的,命中测试永远落不进去,等同于不存在。
                            留下的是 ...Into(并入中央标签组)与 ...AsAnchorablePane(停到侧边),
                            这两类才是本壳支持的落法。
                        -->
                        <Grid x:Name="PART_DocumentPaneDropTargets">
                            <Path Width="122"
                                  Height="122"
                                  Data="{DynamicResource DockPaneEmpty}"
                                  Fill="{DynamicResource {x:Static reskeys:ResourceKeys.DockingButtonStarBackgroundBrushKey}}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource {x:Static reskeys:ResourceKeys.DockingButtonStarBorderBrushKey}}"
                                  StrokeThickness="1"
                                  IsHitTestVisible="False" />
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <ContentControl x:Name="PART_DocumentPaneDropTargetTop" Visibility="Collapsed" Grid.Row="0" Grid.Column="1" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentTop}" />
                                <ContentControl x:Name="PART_DocumentPaneDropTargetRight" Visibility="Collapsed" Grid.Row="1" Grid.Column="2" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentRight}" />
                                <ContentControl x:Name="PART_DocumentPaneDropTargetBottom" Visibility="Collapsed" Grid.Row="2" Grid.Column="1" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentBottom}" />
                                <ContentControl x:Name="PART_DocumentPaneDropTargetLeft" Visibility="Collapsed" Grid.Row="1" Grid.Column="0" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentLeft}" />
                                <ContentControl x:Name="PART_DocumentPaneDropTargetInto" Grid.Row="1" Grid.Column="1" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentInside}" />
                            </Grid>
                        </Grid>

                        <Grid x:Name="PART_DocumentPaneFullDropTargets">
                            <Path Width="204"
                                  Height="204"
                                  Data="{DynamicResource DockPaneLargeEmpty}"
                                  Fill="{DynamicResource {x:Static reskeys:ResourceKeys.DockingButtonStarBackgroundBrushKey}}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource {x:Static reskeys:ResourceKeys.DockingButtonStarBorderBrushKey}}"
                                  StrokeThickness="1"
                                  IsHitTestVisible="False" />
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <ContentControl x:Name="PART_DocumentPaneFullDropTargetTop" Visibility="Collapsed" Grid.Row="1" Grid.Column="2" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentTop}" />
                                <ContentControl x:Name="PART_DocumentPaneFullDropTargetRight" Visibility="Collapsed" Grid.Row="2" Grid.Column="3" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentRight}" />
                                <ContentControl x:Name="PART_DocumentPaneFullDropTargetBottom" Visibility="Collapsed" Grid.Row="3" Grid.Column="2" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentBottom}" />
                                <ContentControl x:Name="PART_DocumentPaneFullDropTargetLeft" Visibility="Collapsed" Grid.Row="2" Grid.Column="1" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentLeft}" />
                                <ContentControl x:Name="PART_DocumentPaneFullDropTargetInto" Grid.Row="2" Grid.Column="2" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentInside}" />
                                <ContentControl x:Name="PART_DocumentPaneDropTargetTopAsAnchorablePane" Grid.Row="0" Grid.Column="2" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentAsAnchorableTop}" />
                                <ContentControl x:Name="PART_DocumentPaneDropTargetRightAsAnchorablePane" Grid.Row="2" Grid.Column="4" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentAsAnchorableRight}" />
                                <ContentControl x:Name="PART_DocumentPaneDropTargetBottomAsAnchorablePane" Grid.Row="4" Grid.Column="2" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentAsAnchorableBottom}" />
                                <ContentControl x:Name="PART_DocumentPaneDropTargetLeftAsAnchorablePane" Grid.Row="2" Grid.Column="0" Style="{StaticResource AuroraOverlayHitTarget}" Content="{StaticResource DockDocumentAsAnchorableLeft}" />
                            </Grid>
                        </Grid>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
