<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:adc="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
                    xmlns:base="clr-namespace:HistoryAurora.Shell.Base">

    <!--
        UI-01 / UI-04 / UI-06:AvalonDock 覆盖层。

        窗格控件样式必须经 DockingManager.AnchorablePaneControlStyle /
        DocumentPaneControlStyle 属性下发(主题字典里的隐式 Style 不命中窗格控件);
        页签容器样式由那两个样式的 ItemContainerStyle 带下去。
        主题画刷键的覆盖在 AuroraTokens[.Dark].xaml —— 随主题整份切换。

        1.20.2 起所有页都是 LayoutAnchorable(REQ-UI-102),没有页签行、没有页签切换;
        1.20.3 起页签模板本身也是空的(REQ-UI-103)。
    -->

    <!-- ================================================================ 页签容器(只剩壳) -->

    <!--
        1.20.3(REQ-UI-103):顶栏视觉的最后一块。1.20.2 删掉了页签**行**,页签本身的模板
        (标题文字、关闭按钮、悬停与选中触发器,约 90 行)却还留着,在一行高 0、不可见、
        不接收输入的格子里照常被构造与绑定 —— 画出来给谁看都没有,改坏了也没人看得见。
        本版把模板清空,只留下面这层最小的壳。

        壳为什么不能一起删:窗格控件是 TabControl,它要靠**生成出来的页签容器**才产出
        SelectedContent;整份 ItemContainerStyle 拿掉,内容区就是空白(REQ-UI-101 第 1 条)。
        容器里的 adc:LayoutXxxTabItem 也留着 —— AvalonDock 的激活与选中同步挂在它身上,
        它只是没有可见的模板了。

        页签 DataContext 就是 LayoutContent(LayoutAnchorable),故可直接绑定 Title / IsSelected。
        (经运行期探针确认)
    -->
    <ControlTemplate x:Key="Aurora.Docking.TabItemTemplate" TargetType="{x:Type Control}">
        <Border Background="Transparent" />
    </ControlTemplate>

    <Style x:Key="Aurora.Docking.DocumentTabItemStyle" TargetType="{x:Type adc:LayoutDocumentTabItem}">
        <Setter Property="Template" Value="{StaticResource Aurora.Docking.TabItemTemplate}" />
    </Style>

    <Style x:Key="Aurora.Docking.AnchorableTabItemStyle" TargetType="{x:Type adc:LayoutAnchorableTabItem}">
        <Setter Property="Template" Value="{StaticResource Aurora.Docking.TabItemTemplate}" />
    </Style>

    <!--
        窗格控件是 TabControl,页签容器因此是普通 TabItem;AvalonDock 的
        LayoutDocumentTabItem / LayoutAnchorableTabItem 是容器模板里承担
        激活与选中同步的那一层。所以外层样式必须 TargetType=TabItem,
        内层才换我们的模板 —— 直接给容器套 LayoutXxxTabItem 样式会抛
        「样式不适用于类型 TabItem」。
    -->
    <Style x:Key="Aurora.Docking.DocumentTabContainerStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <adc:LayoutDocumentTabItem Model="{Binding}"
                                               Style="{StaticResource Aurora.Docking.DocumentTabItemStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Aurora.Docking.AnchorableTabContainerStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <adc:LayoutAnchorableTabItem Model="{Binding}"
                                                 Style="{StaticResource Aurora.Docking.AnchorableTabItemStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        工具页内容宿主:原模板是「标题条 + 内容」两段,标题条就是那条蓝条。改成内容铺满。
        1.20.2 顶栏删除(REQ-UI-101):页签行上的「恢复页面」等动作一并删掉,
        退出专注走右栏窗口控制组里的按钮、F11 或 Esc。
    -->
    <Style TargetType="{x:Type adc:LayoutAnchorableControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type adc:LayoutAnchorableControl}">
                    <!-- 内容铺满:标题条已取消,动作图标搬到窗格模板的页签行里(R4-1) -->
                    <ContentPresenter Content="{Binding Model.Content,
                                      RelativeSource={RelativeSource TemplatedParent}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 拖拽分隔条(UI-01.2) -->

    <Style TargetType="{x:Type adc:LayoutGridResizerControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type adc:LayoutGridResizerControl}">
                    <Grid Background="Transparent">
                        <Border x:Name="Hint"
                                Margin="2"
                                Background="{DynamicResource Aurora.Brush.Accent}"
                                CornerRadius="1"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hint" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 窗格模板:卡片形态 -->

    <!--
        UI-01:窗格 = 圆角卡片 + 投影 + 外缘间隙。透明底层 Border 必须保留 —— 拖拽停靠依赖它捕获鼠标事件。

        1.20.2 顶栏删除(REQ-UI-101):一格一页(REQ-UI-100),页签行不再画出来,没有页签切换。
        页签面板仍然留着、高 0、不可见、不接收输入:窗格控件是 TabControl,
        它要靠生成出来的页签容器才产出 SelectedContent —— 整个拿掉,内容区就是空白。
    -->
    <ControlTemplate x:Key="Aurora.Docking.AnchorablePaneTemplate"
                     TargetType="{x:Type adc:LayoutAnchorablePaneControl}">
        <Border Margin="{DynamicResource Aurora.Space.Gap}"
                Background="{DynamicResource Aurora.Brush.Surface}"
                CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                Effect="{DynamicResource Aurora.Shadow.Card}"
                SnapsToDevicePixels="True">
            <Grid ClipToBounds="True"
                  KeyboardNavigation.TabNavigation="Local"
                  SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Background="Transparent" />
                <!-- 页签行已删:只留生成页签容器用的面板,高 0、不可见、不接收输入 -->
                <Grid Grid.Row="0" Height="0" ClipToBounds="True" Visibility="Hidden" IsHitTestVisible="False">
                    <adc:AnchorablePaneTabPanel x:Name="HeaderPanel" IsItemsHost="True" />
                </Grid>
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  Grid.Row="1"
                                  Margin="{TemplateBinding Padding}"
                                  Content="{TemplateBinding SelectedContent}"
                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                  ContentSource="SelectedContent"
                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                  KeyboardNavigation.TabIndex="2"
                                  KeyboardNavigation.TabNavigation="Cycle"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                <!--
                    Ctrl 标签态(REQ-UI-097):内容换成写着页名的大标签,按住就能把整页拖走。

                    CornerRadius 必须跟着卡片(REQ-UI-105,1.20.3):这块盖板是卡片里**最上面**的一层,
                    圆角由外层卡片 Border 画、而 WPF 的 CornerRadius 不裁剪子元素 ——
                    盖板不自己带圆角的话,四个角就被它填成直角,按住 Ctrl 时整页从圆角矩形变成尖角矩形。
                    它铺满第 1 行,而第 0 行(页签容器)高 0,所以取与卡片同一个 Aurora.Radius.Inner 即可对齐。
                -->
                <Border x:Name="PageLabelCover"
                        Grid.Row="1"
                        Panel.ZIndex="3"
                        Tag="PageLabelCover"
                        Visibility="Collapsed"
                        Cursor="SizeAll"
                        CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                        Background="{DynamicResource Aurora.Brush.Surface}">
                    <!-- 1.20.1:内容整片隐去,正中只剩一枚页签形的标签(用户原话「整体页面居中显示自己的标签」) -->
                    <Border Margin="{DynamicResource Aurora.Space.PadTight}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MinWidth="140"
                            MinHeight="{DynamicResource Aurora.Size.Tab}"
                            Padding="22,8"
                            Background="{DynamicResource Aurora.Brush.AccentSoft}"
                            BorderBrush="{DynamicResource Aurora.Brush.Accent}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Aurora.Radius.TabInner}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Aurora.Font.Family}"
                                   FontSize="{DynamicResource Aurora.Font.Body}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Aurora.Brush.TextPrimary}"
                                   Text="{Binding SelectedItem.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Border>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Tag.IsChecked, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter TargetName="PageLabelCover" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Aurora.Docking.DocumentPaneTemplate"
                     TargetType="{x:Type adc:LayoutDocumentPaneControl}">
        <Border Margin="{DynamicResource Aurora.Space.Gap}"
                Background="{DynamicResource Aurora.Brush.Surface}"
                CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                Effect="{DynamicResource Aurora.Shadow.Card}"
                SnapsToDevicePixels="True">
            <Grid ClipToBounds="True"
                  KeyboardNavigation.TabNavigation="Local"
                  SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Background="Transparent" />
                <!-- 页签行已删(顶栏删除,REQ-UI-101):只留生成页签容器用的面板 -->
                <Grid Grid.Row="0" Height="0" ClipToBounds="True" Visibility="Hidden" IsHitTestVisible="False">
                    <adc:DocumentPaneTabPanel x:Name="HeaderPanel" IsItemsHost="True" />
                </Grid>
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  Grid.Row="1"
                                  Margin="{TemplateBinding Padding}"
                                  Content="{TemplateBinding SelectedContent}"
                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                  ContentSource="SelectedContent"
                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                  KeyboardNavigation.TabIndex="2"
                                  KeyboardNavigation.TabNavigation="Cycle"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                <!-- Ctrl 标签态(REQ-UI-097),与工具窗格同一块;圆角同上(REQ-UI-105) -->
                <Border x:Name="PageLabelCover"
                        Grid.Row="1"
                        Panel.ZIndex="3"
                        Tag="PageLabelCover"
                        Visibility="Collapsed"
                        Cursor="SizeAll"
                        CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                        Background="{DynamicResource Aurora.Brush.Surface}">
                    <!-- 1.20.1:内容整片隐去,正中只剩一枚页签形的标签(用户原话「整体页面居中显示自己的标签」) -->
                    <Border Margin="{DynamicResource Aurora.Space.PadTight}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MinWidth="140"
                            MinHeight="{DynamicResource Aurora.Size.Tab}"
                            Padding="22,8"
                            Background="{DynamicResource Aurora.Brush.AccentSoft}"
                            BorderBrush="{DynamicResource Aurora.Brush.Accent}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Aurora.Radius.TabInner}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Aurora.Font.Family}"
                                   FontSize="{DynamicResource Aurora.Font.Body}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Aurora.Brush.TextPrimary}"
                                   Text="{Binding SelectedItem.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Border>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Tag.IsChecked, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter TargetName="PageLabelCover" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ================================================================ 窗格模板:专注形态(UI-04) -->

    <ControlTemplate x:Key="Aurora.Docking.AnchorablePaneTemplate.Chromeless"
                     TargetType="{x:Type adc:LayoutAnchorablePaneControl}">
        <Grid Background="{DynamicResource Aurora.Brush.Surface}"
              ClipToBounds="True"
              KeyboardNavigation.TabNavigation="Local"
              SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 专注态同样没有页签行;窗口控制组一直在右栏 -->
            <Grid Grid.Row="0" Height="0" ClipToBounds="True" Visibility="Hidden" IsHitTestVisible="False">
                <adc:AnchorablePaneTabPanel x:Name="HeaderPanel" IsItemsHost="True" />
            </Grid>
            <ContentPresenter x:Name="PART_SelectedContentHost"
                              Grid.Row="1"
                              Margin="0"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                              ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                              ContentSource="SelectedContent"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.TabNavigation="Cycle"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Grid>
    </ControlTemplate>

    <!-- Keep AvalonDock's FloatingWindowContentHost and remove only its outer title row. -->
    <Style TargetType="{x:Type adc:LayoutAnchorableFloatingWindowControl}">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aurora.Brush.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--
            CaptionHeight 必须是 0。

            1.7.1/1.7.2 曾把它抬到 35，理由是「AvalonDock 要收到
            WM_NCLBUTTONDOWN/HTCAPTION 才会建 DragService」。**那条理由是错的**：
            反编译 LayoutFloatingWindowControl.FilterMessage 后确认，它只处理
            WM_SYSCOMMAND(0x0112，且仅 SC_MAXIMIZE/SC_RESTORE)、WM_LBUTTONUP(0x0202)、
            WM_MOVING(0x0216)、WM_EXITSIZEMOVE(0x0232)——**根本不看非客户区消息**。
            真正建 DragService 的是 WM_MOVING → UpdateDragPosition，
            也就是"窗口正在被系统的移动循环拖着"这件事本身。

            而抬高 CaptionHeight 有害：页头那一条随即变成非客户区，
            WPF 不再收到鼠标按下，Aurora 自己的拖动手势（它才会去调 DragMove）
            压根起不来。所以这里回到 0。
        -->
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="0"
                              ResizeBorderThickness="6"
                              GlassFrameThickness="0"
                              CornerRadius="0"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type adc:LayoutAnchorableFloatingWindowControl}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter DataContext="{x:Null}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type adc:LayoutDocumentFloatingWindowControl}">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aurora.Brush.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--
            CaptionHeight 必须是 0。

            1.7.1/1.7.2 曾把它抬到 35，理由是「AvalonDock 要收到
            WM_NCLBUTTONDOWN/HTCAPTION 才会建 DragService」。**那条理由是错的**：
            反编译 LayoutFloatingWindowControl.FilterMessage 后确认，它只处理
            WM_SYSCOMMAND(0x0112，且仅 SC_MAXIMIZE/SC_RESTORE)、WM_LBUTTONUP(0x0202)、
            WM_MOVING(0x0216)、WM_EXITSIZEMOVE(0x0232)——**根本不看非客户区消息**。
            真正建 DragService 的是 WM_MOVING → UpdateDragPosition，
            也就是"窗口正在被系统的移动循环拖着"这件事本身。

            而抬高 CaptionHeight 有害：页头那一条随即变成非客户区，
            WPF 不再收到鼠标按下，Aurora 自己的拖动手势（它才会去调 DragMove）
            压根起不来。所以这里回到 0。
        -->
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="0"
                              ResizeBorderThickness="6"
                              GlassFrameThickness="0"
                              CornerRadius="0"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type adc:LayoutDocumentFloatingWindowControl}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter DataContext="{x:Null}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Aurora.Docking.DocumentPaneTemplate.Chromeless"
                     TargetType="{x:Type adc:LayoutDocumentPaneControl}">
        <Grid Background="{DynamicResource Aurora.Brush.Surface}"
              ClipToBounds="True"
              KeyboardNavigation.TabNavigation="Local"
              SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="0" ClipToBounds="True" Visibility="Hidden" IsHitTestVisible="False">
                <adc:DocumentPaneTabPanel x:Name="HeaderPanel" IsItemsHost="True" />
            </Grid>
            <ContentPresenter x:Name="PART_SelectedContentHost"
                              Grid.Row="1"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                              ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                              ContentSource="SelectedContent"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.TabNavigation="Cycle"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
