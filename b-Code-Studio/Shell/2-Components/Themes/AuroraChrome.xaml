<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        UI-02 / UI-03 / UI-05:窗口控件、菜单按钮、错误徽章与瞬时提示。
        顶栏已删(REQ-UI-101),这几样如今都长在右栏顶部。
        图标一律用 Path 绘制,不依赖 Segoe MDL2 Assets 等字体 —— 目标平台是
        Win10 IoT LTSC 2021,精简镜像可能缺字体。
    -->

    <!-- ================================================================ 窗口控件(UI-02.3) -->

    <!--
        菜单 + 最小化 + 最大化还原 + 关闭 共用底座。
        WindowChrome.IsHitTestVisibleInChrome=True 保留为兼容性保护；主窗体的
        CaptionHeight 恒为 0，拖动由右栏与停靠区的空白自己处理（REQ-UI-107）。
    -->
    <Style x:Key="Aurora.WindowButton" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource Aurora.Size.WindowButton}" />
        <Setter Property="Height" Value="{DynamicResource Aurora.Size.Tab}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.WindowButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.WindowButtonPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Aurora.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮:悬停整块变红、图标转白,与 Windows 惯例一致(UI-02.4) -->
    <Style x:Key="Aurora.WindowButton.Close" TargetType="Button"
           BasedOn="{StaticResource Aurora.WindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.CloseHover}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Aurora.Brush.TextOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.CloseHoverPressed}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Aurora.Brush.TextOnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 控制组图标(菜单、退出专注):与窗口控件同底座,宽度略窄 -->
    <Style x:Key="Aurora.ChromeIconButton" TargetType="Button"
           BasedOn="{StaticResource Aurora.WindowButton}">
        <Setter Property="Width" Value="36" />
    </Style>


    <!-- ================================================================ 错误徽章(UI-05.3) -->

    <Style x:Key="Aurora.ErrorBadge" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.DangerSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.Danger}" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.Danger}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Aurora.Brush.TextOnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
