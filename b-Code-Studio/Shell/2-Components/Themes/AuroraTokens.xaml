<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:reskeys="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013">

    <!--
        UI-08:3.1 设计令牌(浅色)。Shell 层唯一允许出现颜色与圆角字面量的地方之一
        (另一处是 AuroraTokens.Dark.xaml),其余 XAML 一律经 DynamicResource 引用。

        AvalonDock 主题画刷键(reskeys)也在这里定义:主题切换时整份字典被替换,
        应用色与停靠色因此始终同步,不会出现「界面已深色、页签仍浅色」。
        主题色(Accent)按 3.1 决议统一为暗黄,浅色深色只差明度。

        1.26.0(REQ-UI-127):浅色中性色改取 OneHistory 站点(onehistory.exc0.top,
        2026-031 b-Site/assets/site.css)的暖纸色系 —— Canvas / SurfaceAlt / ControlBorder
        分别对应站点的 canvas / surface-2 / hairline-2;悬停、按下、发丝线沿同一暖色相推出。
        深色本来就与站点深色同源,不动。
    -->

    <!-- ================================================================ 颜色 -->

    <SolidColorBrush x:Key="Aurora.Brush.Canvas" Color="#F7F5EF" />
    <SolidColorBrush x:Key="Aurora.Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Aurora.Brush.SurfaceAlt" Color="#F1EEE6" />
    <SolidColorBrush x:Key="Aurora.Brush.SurfaceHover" Color="#EBE7DD" />
    <SolidColorBrush x:Key="Aurora.Brush.SurfacePressed" Color="#E1DCCF" />

    <SolidColorBrush x:Key="Aurora.Brush.TextPrimary" Color="#1F2328" />
    <SolidColorBrush x:Key="Aurora.Brush.TextSecondary" Color="#6B7280" />
    <SolidColorBrush x:Key="Aurora.Brush.TextDisabled" Color="#A7A396" />
    <SolidColorBrush x:Key="Aurora.Brush.TextOnAccent" Color="#FFFFFF" />

    <!-- 主题色:暗黄 -->
    <SolidColorBrush x:Key="Aurora.Brush.Accent" Color="#A87A12" />
    <SolidColorBrush x:Key="Aurora.Brush.AccentHover" Color="#8C650E" />
    <SolidColorBrush x:Key="Aurora.Brush.AccentSoft" Color="#FAF0D8" />

    <SolidColorBrush x:Key="Aurora.Brush.Danger" Color="#C42525" />
    <SolidColorBrush x:Key="Aurora.Brush.DangerSoft" Color="#FBE9E9" />
    <SolidColorBrush x:Key="Aurora.Brush.Warning" Color="#B26A00" />
    <SolidColorBrush x:Key="Aurora.Brush.Success" Color="#1E7F4B" />

    <!-- UI-01.3:Hairline 只用于卡片内部必要分隔(含分段工具条的切分线),不用于卡片之间 -->
    <SolidColorBrush x:Key="Aurora.Brush.Hairline" Color="#E4DFD4" />
    <SolidColorBrush x:Key="Aurora.Brush.ControlBorder" Color="#D8D3C6" />

    <!-- 顶部控件条与窗口按钮(UI-02) -->
    <SolidColorBrush x:Key="Aurora.Brush.WindowButtonHover" Color="#E6E1D5" />
    <SolidColorBrush x:Key="Aurora.Brush.WindowButtonPressed" Color="#D6CFBF" />
    <SolidColorBrush x:Key="Aurora.Brush.CloseHover" Color="#C42525" />
    <SolidColorBrush x:Key="Aurora.Brush.CloseHoverPressed" Color="#A81E1E" />

    <!-- ================================================================ 形状 -->

    <!-- UI-02.1 / Q-4:Win10 IoT 无系统窗口圆角,窗体外缘恒为直角 -->
    <CornerRadius x:Key="Aurora.Radius.Window">0</CornerRadius>
    <!--
        REQ-UI-119(1.22 页面新风格):页面与组件分开两级圆角,且**同心**——
        Page = Inner + 页面内边距(PageRegistrar.PagePad / Aurora.Space.PageInset)。
        贴着页面四角的组件(面板底板、表头、控制台工具条)因此与卡片外缘平行。
        三个数改任何一个都要同步另外两个,合同测试按这条等式判。
    -->
    <CornerRadius x:Key="Aurora.Radius.Page">20</CornerRadius>
    <!-- 组件圆角:按钮、输入、底板、弹层。4 实测显得僵硬,回到 8 -->
    <CornerRadius x:Key="Aurora.Radius.Inner">8</CornerRadius>
    <!--
        停靠页签已随顶栏删除,这两个值现在只服务分段工具条与 Ctrl 标签态的那枚标签。
    -->
    <CornerRadius x:Key="Aurora.Radius.TabTop">5,5,0,0</CornerRadius>
    <CornerRadius x:Key="Aurora.Radius.TabInner">5</CornerRadius>

    <!-- ================================================================ 间距与尺寸 -->

    <Thickness x:Key="Aurora.Space.Gap">1</Thickness>
    <Thickness x:Key="Aurora.Space.Pad">12</Thickness>
    <!-- 页面内容相对卡片的内边距(REQ-UI-119),与 PageRegistrar.PagePad 同值 -->
    <Thickness x:Key="Aurora.Space.PageInset">12</Thickness>
    <Thickness x:Key="Aurora.Space.PadTight">8</Thickness>
    <Thickness x:Key="Aurora.Space.ControlPad">10,4</Thickness>

    <sys:Double x:Key="Aurora.Size.Control">28</sys:Double>
    <sys:Double x:Key="Aurora.Size.WindowButton">44</sys:Double>
    <!--
        控件条高。页签行已随顶栏删除(REQ-UI-101),这个值现在量的是右栏顶部的窗口按钮组、
        对话框标题条与 Ctrl 标签态那枚标签的最小高度 —— 键名保留,改名要动四处消费方。
    -->
    <sys:Double x:Key="Aurora.Size.Tab">32</sys:Double>

    <!-- AvalonDock 停靠覆盖按钮：保持可识别，但不要遮住整块工作区。 -->
    <sys:Double x:Key="{x:Static reskeys:ResourceKeys.DockingButtonWidthKey}">28</sys:Double>
    <sys:Double x:Key="{x:Static reskeys:ResourceKeys.DockingButtonHeightKey}">28</sys:Double>

    <sys:Double x:Key="Aurora.Font.Body">13</sys:Double>
    <sys:Double x:Key="Aurora.Font.Small">11</sys:Double>
    <sys:Double x:Key="Aurora.Font.Mono">12</sys:Double>

    <FontFamily x:Key="Aurora.Font.Family">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Aurora.Font.MonoFamily">Consolas</FontFamily>

    <!-- ================================================================ 投影(UI-01) -->

    <!-- UI-09.4:投影只挂窗格级 Border,不用于列表项等高频元素 -->
    <DropShadowEffect x:Key="Aurora.Shadow.Card"
                      Color="#000000" BlurRadius="10" ShadowDepth="1"
                      Direction="270" Opacity="0.05" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Aurora.Shadow.CardActive"
                      Color="#000000" BlurRadius="14" ShadowDepth="1"
                      Direction="270" Opacity="0.08" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Aurora.Shadow.Flyout"
                      Color="#000000" BlurRadius="28" ShadowDepth="4"
                      Direction="270" Opacity="0.18" RenderingBias="Performance" />

    <!-- ================================================================ 文本 -->

    <Style x:Key="Aurora.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Aurora.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Aurora.Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Aurora.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Aurora.Text.Secondary}">
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
    </Style>

    <!-- ================================================================ AvalonDock 主题画刷键 -->

    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.TabBackground}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.PanelBorderBrush}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabSelectedActiveBackground}" Color="#FAF0D8" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabSelectedInactiveBackground}" Color="#F1EEE6" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabUnselectedBackground}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabUnselectedHoveredBackground}" Color="#EBE7DD" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowTabSelectedActiveBackground}" Color="#FAF0D8" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowTabSelectedInactiveBackground}" Color="#F1EEE6" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowTabUnselectedBackground}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowTabUnselectedHoveredBackground}" Color="#EBE7DD" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowCaptionActiveBackground}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowCaptionInactiveBackground}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabDefaultBackground}" Color="#EEEAE1" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabDefaultBorder}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabHoveredBackground}" Color="#FAF0D8" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabHoveredBorder}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.FloatingToolWindowBackground}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.FloatingToolWindowBorder}" Color="#E4DFD4" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.FloatingDocumentWindowBackground}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.FloatingDocumentWindowBorder}" Color="#E4DFD4" />

    <!--
        停靠覆盖层专用画刷。VS2013 的默认调色板在宿主的可回收模块上下文中
        可能无法解析 DockTargetGlyph*，其回退值是全透明；覆盖窗因此有模板却
        不产生任何像素。这里由 Aurora 明确定义，保证蓝色方位指示与预览框始终可见。
    -->
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonBackgroundBrushKey}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonForegroundBrushKey}" Color="#FF2563EB" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonForegroundArrowBrushKey}" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonStarBorderBrushKey}" Color="#8060A5FA" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonStarBackgroundBrushKey}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.PreviewBoxBorderBrushKey}" Color="#FF2563EB" />
    <!-- The target rectangle is intentionally outline-only; a filled preview
         covers adjacent floating windows because OverlayWindow spans the host. -->
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.PreviewBoxBackgroundBrushKey}" Color="#003B82F6" />

</ResourceDictionary>
