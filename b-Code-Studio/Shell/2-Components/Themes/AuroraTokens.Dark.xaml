<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:reskeys="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013">

    <!--
        UI-08 深色令牌(S-04 落地)。键名与 AuroraTokens.xaml 逐一对应,主题切换
        整份替换,不做逐键覆盖 —— 少一个键就会露出浅色底,所以两份必须同步维护。
        主题色仍是暗黄,深色下提亮以保证对比度。
    -->

    <!-- ================================================================ 颜色 -->

    <!-- 1.40.0 文字只有一种颜色;1.42.0 起深浅分开设定,页面底色、控制面板色、墨色块回到原值,见浅色令牌 -->
    <Color x:Key="Aurora.Color.Canvas">#121414</Color>
    <Color x:Key="Aurora.Color.Text">#DAD7CE</Color>
    <Color x:Key="Aurora.Color.Surface">#1D201F</Color>
    <Color x:Key="Aurora.Color.SurfaceAlt">#242625</Color>
    <Color x:Key="Aurora.Color.SurfaceHover">#2A2D2C</Color>
    <Color x:Key="Aurora.Color.SurfacePressed">#343736</Color>
    <Color x:Key="Aurora.Color.AccentSoft">#33342A</Color>

    <SolidColorBrush x:Key="Aurora.Brush.Canvas" Color="{StaticResource Aurora.Color.Canvas}" />
    <SolidColorBrush x:Key="Aurora.Brush.Surface" Color="{StaticResource Aurora.Color.Surface}" />
    <SolidColorBrush x:Key="Aurora.Brush.SurfaceAlt" Color="{StaticResource Aurora.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Aurora.Brush.SurfaceHover" Color="{StaticResource Aurora.Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Aurora.Brush.SurfacePressed" Color="{StaticResource Aurora.Color.SurfacePressed}" />

    <SolidColorBrush x:Key="Aurora.Brush.TextPrimary" Color="{StaticResource Aurora.Color.Text}" />
    <SolidColorBrush x:Key="Aurora.Brush.TextSecondary" Color="{StaticResource Aurora.Color.Text}" />
    <SolidColorBrush x:Key="Aurora.Brush.TextDisabled" Color="#77746A" />

    <!-- 主题色:暗黄(深色底上提亮) -->
    <SolidColorBrush x:Key="Aurora.Brush.Accent" Color="#D9A441" />
    <SolidColorBrush x:Key="Aurora.Brush.AccentSoft" Color="{StaticResource Aurora.Color.AccentSoft}" />

    <SolidColorBrush x:Key="Aurora.Brush.Danger" Color="#E06C6C" />
    <SolidColorBrush x:Key="Aurora.Brush.DangerSoft" Color="#3A2320" />
    <SolidColorBrush x:Key="Aurora.Brush.Warning" Color="#E0A458" />

    <SolidColorBrush x:Key="Aurora.Brush.Hairline" Color="{StaticResource Aurora.Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Aurora.Brush.ControlBorder" Color="{StaticResource Aurora.Color.SurfacePressed}" />

    <!-- 墨色与反白(REQ-UI-132),见浅色令牌。深色里墨色条是亮条 -->
    <SolidColorBrush x:Key="Aurora.Brush.Ink" Color="#E2DAC6" />
    <SolidColorBrush x:Key="Aurora.Brush.OnInk" Color="{StaticResource Aurora.Color.Canvas}" />
    <SolidColorBrush x:Key="Aurora.Brush.TextSecondaryOnInk" Color="#6A6458" />

    <!-- ================================================================ 形状 -->

    <CornerRadius x:Key="Aurora.Radius.Window">0</CornerRadius>
    <!-- 同心:Page = Inner + PageInset(REQ-UI-119),见浅色令牌 -->
    <CornerRadius x:Key="Aurora.Radius.Page">20</CornerRadius>
    <CornerRadius x:Key="Aurora.Radius.Inner">8</CornerRadius>
    <CornerRadius x:Key="Aurora.Radius.Bar">5</CornerRadius>
    <CornerRadius x:Key="Aurora.Radius.TabTop">5,5,0,0</CornerRadius>
    <CornerRadius x:Key="Aurora.Radius.TabInner">5</CornerRadius>

    <!-- ================================================================ 间距与尺寸 -->

    <Thickness x:Key="Aurora.Space.Gap">1</Thickness>
    <Thickness x:Key="Aurora.Space.Pad">12</Thickness>
    <Thickness x:Key="Aurora.Space.PageInset">12</Thickness>
    <Thickness x:Key="Aurora.Space.PadTight">8</Thickness>
    <Thickness x:Key="Aurora.Space.ControlPad">10,4</Thickness>

    <sys:Double x:Key="Aurora.Size.Control">28</sys:Double>
    <sys:Double x:Key="Aurora.Size.WindowButton">44</sys:Double>
    <sys:Double x:Key="Aurora.Size.Tab">32</sys:Double>

    <!-- 与浅色主题保持相同的停靠覆盖按钮尺寸。 -->
    <sys:Double x:Key="{x:Static reskeys:ResourceKeys.DockingButtonWidthKey}">28</sys:Double>
    <sys:Double x:Key="{x:Static reskeys:ResourceKeys.DockingButtonHeightKey}">28</sys:Double>

    <sys:Double x:Key="Aurora.Font.Body">13</sys:Double>
    <sys:Double x:Key="Aurora.Font.ChatHeading">18</sys:Double>
    <sys:Double x:Key="Aurora.Font.Small">11</sys:Double>
    <sys:Double x:Key="Aurora.Font.Mono">12</sys:Double>

    <FontFamily x:Key="Aurora.Font.Family">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Aurora.Font.MonoFamily">Consolas</FontFamily>

    <!-- ================================================================ 投影 -->

    <!-- 窗格只保留轻微层次，不形成悬浮卡片感。 -->
    <DropShadowEffect x:Key="Aurora.Shadow.Card"
                      Color="#000000" BlurRadius="10" ShadowDepth="1"
                      Direction="270" Opacity="0.18" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Aurora.Shadow.CardActive"
                      Color="#000000" BlurRadius="14" ShadowDepth="1"
                      Direction="270" Opacity="0.24" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Aurora.Shadow.Flyout"
                      Color="#000000" BlurRadius="28" ShadowDepth="4"
                      Direction="270" Opacity="0.65" RenderingBias="Performance" />

    <!-- ================================================================ 文本 -->

    <Style x:Key="Aurora.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Aurora.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Aurora.Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Aurora.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Aurora.Text.Secondary}">
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
    </Style>

    <!-- ================================================================ AvalonDock 主题画刷键 -->

    <!-- 与浅色同一套映射;原先只在这里出现的 #262A28 / #171918 并回 SurfaceAlt(1.40.0) -->
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.TabBackground}" Color="{StaticResource Aurora.Color.Surface}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.PanelBorderBrush}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabSelectedActiveBackground}" Color="{StaticResource Aurora.Color.AccentSoft}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabSelectedInactiveBackground}" Color="{StaticResource Aurora.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabUnselectedBackground}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabUnselectedHoveredBackground}" Color="{StaticResource Aurora.Color.SurfaceHover}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowTabSelectedActiveBackground}" Color="{StaticResource Aurora.Color.AccentSoft}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowTabSelectedInactiveBackground}" Color="{StaticResource Aurora.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowTabUnselectedBackground}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowTabUnselectedHoveredBackground}" Color="{StaticResource Aurora.Color.SurfaceHover}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowCaptionActiveBackground}" Color="{StaticResource Aurora.Color.Surface}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowCaptionInactiveBackground}" Color="{StaticResource Aurora.Color.Surface}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabDefaultBackground}" Color="{StaticResource Aurora.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabDefaultBorder}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabHoveredBackground}" Color="{StaticResource Aurora.Color.AccentSoft}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabHoveredBorder}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.FloatingToolWindowBackground}" Color="{StaticResource Aurora.Color.Surface}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.FloatingToolWindowBorder}" Color="{StaticResource Aurora.Color.SurfaceHover}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.FloatingDocumentWindowBackground}" Color="{StaticResource Aurora.Color.Surface}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.FloatingDocumentWindowBorder}" Color="{StaticResource Aurora.Color.SurfaceHover}" />

    <!-- 覆盖层专用画刷；不依赖 VS 调色板在宿主中的可选 DockTargetGlyph* 键。 -->
    <!-- 停靠方位指示(功能色,不跟品牌色走)。色值只写在 Aurora.Color.* 这一份;画刷与下面 AvalonDock 键、
         DockingOverlayResourceRepair 的回退都引用它,不再各写一遍蓝色。
         AvalonDock 键不能写成 StaticResource 元素:x:Static 键 + StaticResource 元素会让 BAML 读键时 NullReference(1.26.0,REQ-UI-128)。 -->
    <Color x:Key="Aurora.Color.DockTarget">#FF60A5FA</Color>
    <SolidColorBrush x:Key="Aurora.Brush.DockTarget" Color="{StaticResource Aurora.Color.DockTarget}" />
    <Color x:Key="Aurora.Color.DockTargetArrow">#FF93C5FD</Color>
    <SolidColorBrush x:Key="Aurora.Brush.DockTargetArrow" Color="{StaticResource Aurora.Color.DockTargetArrow}" />
    <Color x:Key="Aurora.Color.DockTargetHalo">#A060A5FA</Color>
    <SolidColorBrush x:Key="Aurora.Brush.DockTargetHalo" Color="{StaticResource Aurora.Color.DockTargetHalo}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonBackgroundBrushKey}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonForegroundBrushKey}" Color="{StaticResource Aurora.Color.DockTarget}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonForegroundArrowBrushKey}" Color="{StaticResource Aurora.Color.DockTargetArrow}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonStarBorderBrushKey}" Color="{StaticResource Aurora.Color.DockTargetHalo}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonStarBackgroundBrushKey}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.PreviewBoxBorderBrushKey}" Color="{StaticResource Aurora.Color.DockTarget}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.PreviewBoxBackgroundBrushKey}" Color="#003B82F6" />

</ResourceDictionary>
