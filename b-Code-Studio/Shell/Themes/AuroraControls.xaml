<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:widgets="clr-namespace:HistoryAurora.Shell.Widgets">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HistoryAurora;component/Themes/AuroraToolTips.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        UI-07 / UI-08:通用控件样式。全部为隐式样式(不带 x:Key),
        因此只命中未显式指定 Style 的控件 —— AvalonDock 自带模板里的按钮
        已由主题赋了显式样式,不会被这里改写。
        颜色与圆角只经 DynamicResource 取自 AuroraTokens.xaml。
    -->

    <!-- ================================================================ 按钮 -->

    <Style x:Key="Aurora.Button.Base" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource Aurora.Space.ControlPad}" />
        <Setter Property="MinHeight" Value="{DynamicResource Aurora.Size.Control}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Ct"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource Aurora.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfaceAlt}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Aurora.Brush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Aurora.Button.Base}" />

    <!-- 主按钮(强调色):派生视图按需显式引用 -->
    <Style x:Key="Aurora.Button.Accent" TargetType="Button" BasedOn="{StaticResource Aurora.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextOnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aurora.Brush.Accent}" />
    </Style>

    <!-- 危险按钮:文字用 Danger,底仍为 Surface(整块红太吵) -->
    <Style x:Key="Aurora.Button.Danger" TargetType="Button" BasedOn="{StaticResource Aurora.Button.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.Danger}" />
    </Style>

    <!-- 无边框图标/文字按钮:工具条使用 -->
    <Style x:Key="Aurora.Button.Ghost" TargetType="Button" BasedOn="{StaticResource Aurora.Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- ================================================================ 输入框 -->

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="MinHeight" Value="{DynamicResource Aurora.Size.Control}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Aurora.Brush.Accent}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource Aurora.Brush.TextDisabled}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource Aurora.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfaceAlt}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Aurora.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 下拉框 -->

    <Style x:Key="Aurora.ComboBox.ToggleButton" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Aurora.Brush.Surface}"
                            BorderBrush="{DynamicResource Aurora.Brush.ControlBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                            SnapsToDevicePixels="True">
                        <Path x:Name="Arrow"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,9,0"
                              Data="M 0 0 L 4 4 L 8 0"
                              Stroke="{DynamicResource Aurora.Brush.TextSecondary}"
                              StrokeThickness="1.4" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource Aurora.Brush.TextDisabled}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource Aurora.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfaceAlt}" />
                            <Setter TargetName="Arrow" Property="Stroke"
                                    Value="{DynamicResource Aurora.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="MinHeight" Value="{DynamicResource Aurora.Size.Control}" />
        <Setter Property="Padding" Value="9,3,26,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Style="{StaticResource Aurora.ComboBox.ToggleButton}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="ContentSite"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <!-- 可编辑下拉需要该命名部件存在,本框架内不使用可编辑形态 -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Margin="{TemplateBinding Padding}"
                                 Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PopupAnimation="Fade"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Margin="0,4,10,10"
                                    Background="{DynamicResource Aurora.Brush.Surface}"
                                    BorderBrush="{DynamicResource Aurora.Brush.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                                    Effect="{DynamicResource Aurora.Shadow.Flyout}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer Margin="3">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Aurora.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 复选框 -->

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="16" Height="16"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Aurora.Brush.Surface}"
                                BorderBrush="{DynamicResource Aurora.Brush.ControlBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Check"
                                  Margin="2,0,0,0"
                                  Data="M 0 4 L 3.5 7.5 L 9 1"
                                  Stroke="{DynamicResource Aurora.Brush.TextOnAccent}"
                                  StrokeThickness="1.8"
                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Aurora.Brush.Accent}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Aurora.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Aurora.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 列表与表格 -->

    <!--
        R4-5:必须连模板一起换。WPF 默认的 ListBox/ListView 模板里有一条
        IsEnabled=False → Background=#F4F4F4 的触发器,它直接改模板内 Border 的底色,
        TemplateBinding 拦不住 —— 「指令详情」的表格在未选中指令时是禁用态,
        深色模式下于是留下一块系统浅灰。这就是「表格里还是白的」的根因。
        ListView 的模板必须保留 GridView 的 ScrollViewer 样式,否则表头整行消失。
    -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}"
                                      Focusable="False"
                                      Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Aurora.Item.Base" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <GridViewRowPresenter x:Name="Row"
                                              Content="{TemplateBinding Content}"
                                              Columns="{Binding View.Columns,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding View,
                                     RelativeSource={RelativeSource AncestorType=ListView}}" Value="{x:Null}">
                            <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListViewItem" BasedOn="{StaticResource Aurora.Item.Base}" />

    <!--
        R3-2:GridView 会给表头显式指定容器样式(系统主题的渐变灰),隐式样式命不中 ——
        深色模式下表头因此还是浅色。所有 GridView 必须显式引用本样式:
        <GridView ColumnHeaderContainerStyle="{StaticResource Aurora.GridHeader}">
    -->
    <Style x:Key="Aurora.GridHeader" TargetType="GridViewColumnHeader">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="26" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{DynamicResource Aurora.Brush.SurfaceAlt}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <!-- 列分隔:只留一条发丝线,且是拖拽改列宽的命中区 -->
                        <Thumb x:Name="PART_HeaderGripper"
                               HorizontalAlignment="Right" Width="8" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent">
                                        <Border Width="1" HorizontalAlignment="Center" Margin="0,6"
                                                Background="{DynamicResource Aurora.Brush.Hairline}" />
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!--
            GridView 的表头行**总会**在最右侧多渲染一个 Role=Padding 的表头,
            用来盖住"列宽之和"与"表宽"之间的余量。它不是列,却和列共用同一个容器样式,
            于是背景、悬停高亮和右缘那条发丝线一并套上去 —— 看起来就是
            「表格最右边多注册了一列空的」。1.6.0 真机上尤其明显:星号列刻意留了
            20px 滚动余量,那块占位正好显形。
            这里把它单独换成一块纯背景:表头栏在整行连成一条,不再多出一格。
        -->
        <Style.Triggers>
            <Trigger Property="Role" Value="Padding">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border Background="{DynamicResource Aurora.Brush.SurfaceAlt}"
                                    SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextSecondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 树 -->

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Aurora.TreeExpander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="16" Height="16">
                        <Path x:Name="Arrow"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0 0 L 4 4 L 0 8"
                              Stroke="{DynamicResource Aurora.Brush.TextSecondary}"
                              StrokeThickness="1.4" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" CenterX="2" CenterY="4" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Stroke"
                                    Value="{DynamicResource Aurora.Brush.TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Padding" Value="3,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                                MinHeight="{TemplateBinding MinHeight}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander"
                                              Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource Aurora.TreeExpander}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter x:Name="PART_Header"
                                                  Grid.Column="1"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header" />
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" SourceName="Bd" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Aurora.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 分段页签(视图内部,非停靠页签) -->

    <!--
        R3-5:必须换掉默认模板 —— WPF 自带的 TabControl 会把内容区刷成系统浅灰
        (#F4F4F4),深色模式下表格就是坐在这块浅灰上,看起来「表格还是白的」。
    -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,8,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel"
                                  Grid.Row="0"
                                  Panel.ZIndex="1"
                                  IsItemsHost="True"
                                  KeyboardNavigation.TabIndex="1" />
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextSecondary}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="{DynamicResource Aurora.Radius.TabTop}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Indicator"
                                Height="2" VerticalAlignment="Bottom"
                                Background="{DynamicResource Aurora.Brush.Accent}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Aurora.Brush.TextPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Aurora.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 分段工具条(3.1 修订) -->

    <!--
        「切分圆角矩形」:整条工具条是一个圆角矩形,内部用发丝线切成若干段,
        段内控件一律去掉自己的边框和底色 —— 顶部因此只剩一个形状,
        而不是十几个各带边框的小控件。
    -->
    <Style x:Key="Aurora.Segment.Bar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.SurfaceAlt}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Aurora.Radius.Inner}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Aurora.Segment.Divider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,7" />
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Hairline}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="Aurora.Segment.Label" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,4,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Aurora.Segment.TextBox" TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="4,3" />
    </Style>

    <Style x:Key="Aurora.Segment.ComboBox" TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,3,24,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="Transparent"
                                            CornerRadius="{DynamicResource Aurora.Radius.TabInner}">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Data="M 0 0 L 4 4 L 8 0"
                                              Stroke="{DynamicResource Aurora.Brush.TextSecondary}"
                                              StrokeThickness="1.3" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Aurora.Brush.SurfaceHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True" Placement="Bottom"
                               PopupAnimation="Fade" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Margin="0,4,10,10"
                                    Background="{DynamicResource Aurora.Brush.Surface}"
                                    BorderBrush="{DynamicResource Aurora.Brush.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                                    Effect="{DynamicResource Aurora.Shadow.Flyout}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer Margin="3">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Aurora.Segment.Button" TargetType="Button" BasedOn="{StaticResource Aurora.Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
    </Style>

    <Style x:Key="Aurora.Segment.CheckBox" TargetType="CheckBox"
           BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,4,0" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
    </Style>

    <!-- ================================================================ 分组框(去边框,只留标题) -->

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <DockPanel>
                        <ContentPresenter DockPanel.Dock="Top"
                                          Margin="2,0,0,4"
                                          ContentSource="Header"
                                          TextElement.Foreground="{DynamicResource Aurora.Brush.TextSecondary}"
                                          TextElement.FontSize="{DynamicResource Aurora.Font.Small}" />
                        <ContentPresenter />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 菜单(UI-03 弹出层) -->

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="0,2,10,10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Aurora.Brush.Hairline}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                            Effect="{DynamicResource Aurora.Shadow.Flyout}"
                            Padding="4"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                                <Path x:Name="SubArrow"
                                      Grid.Column="1"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 0 8"
                                      Stroke="{DynamicResource Aurora.Brush.TextSecondary}"
                                      StrokeThickness="1.4"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               HorizontalOffset="2"
                               Placement="Right"
                               PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsSubmenuOpen}">
                            <Border Margin="0,2,10,10"
                                    Background="{DynamicResource Aurora.Brush.Surface}"
                                    BorderBrush="{DynamicResource Aurora.Brush.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                                    Effect="{DynamicResource Aurora.Shadow.Flyout}"
                                    Padding="4">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="SubArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Aurora.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Hairline}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 滚动条 -->

    <Style x:Key="Aurora.ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Margin="3"
                            Background="{DynamicResource Aurora.Brush.TextDisabled}"
                            CornerRadius="3" Opacity="0.55" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Aurora.ScrollBar.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Background="Transparent" BorderThickness="0"
                                              Focusable="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Background="Transparent" BorderThickness="0"
                                              Focusable="False" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="12" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 表格组件 -->

    <!--
        REQ-UI-007:表格外观的唯一定义处。AuroraTable 按键引用这一组样式,
        宿主传不进颜色、行高与字号 —— 它只提供数据和列宽。
        每个页面各自拼 ListView 的时代就此结束:改一次外观只改这里。
    -->

    <Style x:Key="Aurora.Table.Surface" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Aurora.Table.ListView" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        单元格。省略号是列宽不够时的必然结果，但"被省略掉的那半句"不能就此消失——
        真机上模块管理的描述列被挤成「前…」，那一列等于白占地方。
        因此：**只在真的被截断时**挂提示（`IsTextTrimmed` 是 WPF 自己算的，
        不需要我们去量字宽）。没截断时把提示整个关掉，否则悬停会弹出一模一样的一行字。
    -->
    <Style x:Key="Aurora.Table.Cell" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <!--
            提示的开关由 AuroraTable 在悬停那一刻按实际文字宽度算（见 CellTemplate）。
            这里不写 IsTextTrimmed 触发器：那个属性只有 .NET Framework 4.8 的 WPF 有，
            本仓是 net8.0-windows，XAML 编译期就会报「找不到 Style Property」。
        -->
        <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
        <Setter Property="ToolTipService.IsEnabled" Value="False" />
    </Style>

    <!--
        文本样式不写 BasedOn:Aurora.Text.* 定义在 AuroraTokens.xaml,而本字典不合并它。
        跨字典的 StaticResource 在解析期就抛 XamlParseException,整份控件字典随之失效。
        令牌仍走 DynamicResource,主题切换照常跟随。
    -->
    <Style x:Key="Aurora.Table.Empty" TargetType="TextBlock">
        <Setter Property="Margin" Value="12" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextSecondary}" />
    </Style>

    <!--
        行:固定 30px 高、无圆角、底部一条发丝线。
        不复用 Aurora.Item.Base —— 那条是列表项样式,每行自带 8px 圆角,
        连成表格后每一行都像一张卡片,列也就对不齐了。
    -->
    <Style x:Key="Aurora.Table.Row" TargetType="ListViewItem">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Aurora.Brush.Hairline}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <GridViewRowPresenter x:Name="Row"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Columns="{Binding View.Columns,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 面板组件 -->

    <!--
        REQ-UI-008:面板只有三种小组件 —— 文字、文本框(输入/选择)、按钮。
        样式同样封在组件里,声明侧只写"是什么",不写"长什么样"。
    -->

    <Style x:Key="Aurora.Panel.Text" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Aurora.Panel.Label" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextSecondary}" />
    </Style>

    <!--
        动作未声明时按钮的样子。做成看得见的一块而不是灰按钮:
        "按钮点了没反应"是本轮要消灭的失败形态,它必须在界面上自己说出原因。
    -->
    <Style x:Key="Aurora.Panel.Unbound" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aurora.Brush.Warning}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Aurora.Radius.Inner}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ================================================================ 轮换选项框 -->

    <Style x:Key="Aurora.OptionBox" TargetType="widgets:AuroraOptionBox">
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Aurora.Radius.Inner}" />
        <Setter Property="Padding" Value="{DynamicResource Aurora.Space.ControlPad}" />
        <Setter Property="MinHeight" Value="{DynamicResource Aurora.Size.Control}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="widgets:AuroraOptionBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Content="{TemplateBinding SelectedItem}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Aurora.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Aurora.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Aurora.OptionBox.Flat" TargetType="widgets:AuroraOptionBox" BasedOn="{StaticResource Aurora.OptionBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- ================================================================ 泳道图组件 -->

    <!--
        REQ-UI-010:泳道图的字号与颜色。节点框、边、端点由 AuroraSwimlane 直接按
        Aurora.Brush.* 取色 —— 它们是画出来的图元,不是控件,套 Style 反而绕。
    -->

    <Style x:Key="Aurora.Graph.NodeTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.MonoFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Aurora.Graph.NodeSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Aurora.Graph.LaneTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 已合并的泳道:仍然画出来,但退到次级文本色,一眼能分出哪几条还在推进。 -->
    <Style x:Key="Aurora.Graph.LaneTitleClosed" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextDisabled}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ================================================================ 行操作 -->

    <!--
        REQ-UI-011:表格的行操作。行内按钮与右键菜单是**同一份声明**的两种出口 ——
        一处声明,两处可用;而不是让页面作者在两种控件之间挑一个,挑完还要各写一遍参数。

        为什么要有它:1.6.0 的表格只能选行,行动作只好放到表格下面排成一排,
        于是「看着哪行点哪行」变成「先上去选行、再下来点按钮」,行数一多就是来回移动
        (见 b-Office/前端组件缺失需求书 C1/C2)。
    -->
    <Style x:Key="Aurora.Table.RowAction" TargetType="Button" BasedOn="{StaticResource Aurora.Button.Base}">
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="Aurora.Table.RowActionDanger" TargetType="Button" BasedOn="{StaticResource Aurora.Table.RowAction}">
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aurora.Brush.DangerSoft}" />
    </Style>

    <!-- ================================================================ 弹出层 -->

    <!--
        REQ-UI-012:低频编辑器的容身处。常驻面板会长期占着纵向版面,而它一周也用不到一次
        (需求书 C3)。弹出层用完即收,并且**内容仍是面板那三种小组件** —— 不另立一套声明。
    -->
    <Style x:Key="Aurora.Flyout.Surface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Aurora.Brush.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Aurora.Radius.Inner}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Effect" Value="{DynamicResource Aurora.Shadow.Flyout}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ================================================================ 补全输入框 -->

    <!--
        REQ-UI-013:带候选的输入框。指令名要手打全名、打错要等到执行时才知道,
        是加常驻指令这类操作最常见的一处返工(需求书 C4)。
        候选表的样子归组件,取候选的口径归会话 —— 与控制台补全共用同一个 ICommandCatalogSession。
    -->
    <Style x:Key="Aurora.Suggest.Surface" TargetType="Border" BasedOn="{StaticResource Aurora.Flyout.Surface}">
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style x:Key="Aurora.Suggest.Item" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.MonoFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent"
                            CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Aurora.Brush.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Aurora.Suggest.Hint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextSecondary}" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ================================================================ 指令详情 -->

    <!--
        REQ-UI-014:命令集与指令详情两页由 Aurora 自建。宿主 5.0 拆掉界面 SDK 之后
        这两页整体消失过一轮 —— 它们是控制台以外唯一能查"这条指令收什么参数"的地方,
        不能挂在任何模块在不在场上。
    -->
    <Style x:Key="Aurora.Detail.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.MonoFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Aurora.Detail.Key" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextSecondary}" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="Aurora.Detail.Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Aurora.Detail.Mono" TargetType="TextBlock" BasedOn="{StaticResource Aurora.Detail.Value}">
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.MonoFamily}" />
    </Style>

    <!-- ================================================================ 提示 -->

    <Style x:Key="Aurora.Panel.Surface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Aurora.Radius.Inner}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Aurora.Panel.Input" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="{DynamicResource Aurora.Size.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Aurora.Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
    </Style>

    <Style x:Key="Aurora.Panel.OptionBox" TargetType="widgets:AuroraOptionBox" BasedOn="{StaticResource Aurora.OptionBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style x:Key="Aurora.Panel.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Hairline}" />
        <Setter Property="OpacityMask">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0" />
                    <GradientStop Color="Black" Offset="0.18" />
                    <GradientStop Color="Black" Offset="0.82" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Aurora.Panel.VerticalDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="7,6" />
        <Setter Property="Background" Value="{DynamicResource Aurora.Brush.Hairline}" />
        <Setter Property="OpacityMask">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0" />
                    <GradientStop Color="Black" Offset="0.18" />
                    <GradientStop Color="Black" Offset="0.82" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
