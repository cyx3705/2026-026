<Window x:Class="HistoryAurora.Shell.Composition.ShellWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="clr-namespace:AvalonDock;assembly=AvalonDock"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource Aurora.Brush.Canvas}">

    <!--
        3.1 外壳(UI-02 / UI-03 / UI-04 / UI-05):
        没有独立标题栏那一层 —— 停靠区从窗体顶端起算,窗口按钮组浮在右上角,
        与最上一排页签同处一行(高度都是 Aurora.Size.Tab)。页签之外的空白
        属于 WindowChrome 的标题区,因此仍可拖动、双击最大化和贴边分屏;
        页签本身在 AuroraDocking.xaml 里声明为 IsHitTestVisibleInChrome,可正常点击。

        WindowChrome 的装配与降级在 ShellWindow.xaml.cs 的 SourceInitialized 完成
        (消费方可能在构造之后才改 WindowStyle,构造期判定会误判)。
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 索引 0 是主题令牌,深色切换时整份替换,见 ApplyTheme -->
                <ResourceDictionary Source="/HistoryAurora;component/Themes/AuroraTokens.xaml" />
                <ResourceDictionary Source="/HistoryAurora;component/Themes/AuroraControls.xaml" />
                <ResourceDictionary Source="/HistoryAurora;component/Themes/AuroraChrome.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                AvalonDock 的主题字典。这里**故意**做成具名资源而不是合并项:它不并进本窗体,
                只是借 XAML 编译期把它解析出来,再以**实例**交给 DockManager.Theme。

                为什么不能让 AvalonDock 自己按 URI 去解析(REQ-UI-029):Theme.GetResourceUri()
                那条路会在覆盖窗构造时执行 `new ResourceDictionary { Source = 相对URI }`,
                而模块被装进可回收 ALC、入口程序集不是本程序集时这条解析并不成立。失败后
                WPF 不抛给我们,覆盖窗就带着 0 份字典活下来,画刷全解析不到——元素照常排布、
                Z 序也对,渲染出来一个非透明像素都没有(真机实测)。
                BAML 这条路是成立的:本窗体上面那几份字典正是这么来的。
            -->
            <ResourceDictionary x:Key="AuroraDockTheme"
                                Source="/HistoryAurora;component/Themes/AuroraTheme.xaml" />

            <!-- 图标一律用几何图形,不依赖 Segoe MDL2 Assets(精简镜像可能缺字体) -->
            <Geometry x:Key="Aurora.Icon.Menu">M 0,0 H 14 M 0,5 H 14 M 0,10 H 14</Geometry>
            <Geometry x:Key="Aurora.Icon.Minimize">M 0,0 H 10</Geometry>
            <Geometry x:Key="Aurora.Icon.Maximize">M 0,0 H 10 V 10 H 0 Z</Geometry>
            <Geometry x:Key="Aurora.Icon.Restore">M 0,2.5 H 7.5 V 10 H 0 Z M 2.5,2.5 V 0 H 10 V 7.5 H 7.5</Geometry>
            <Geometry x:Key="Aurora.Icon.Close">M 0,0 L 10,10 M 10,0 L 0,10</Geometry>
            <Geometry x:Key="Aurora.Icon.ExitFocus">M 0,4 H 4 V 0 M 12,0 V 4 H 16 M 16,8 H 12 V 12 M 4,12 V 8 H 0</Geometry>
            <RoutedCommand x:Key="Aurora.Command.PageAction" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- RootBorder:窗体最大化时由代码补偿 WindowChrome 溢出(UI-02.5) -->
    <Border x:Name="RootBorder" Background="{DynamicResource Aurora.Brush.Canvas}">
        <Grid x:Name="RootGrid">
            <!-- 第 0 列是停靠区，第 1 列是右栏（REQ-UI-099，1.20.0 从左侧搬来） -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ad:DockingManager x:Name="DockManager"
                               Grid.Column="0"
                               Background="{DynamicResource Aurora.Brush.Canvas}" />

            <!--
                右栏(REQ-UI-088 / 099):顶部是窗口控制组 —— 原来挂在顶栏右上角,
                搬过来之后仍在整个窗体的右上角;上半列场景,下半列常用页面胶囊。
                空白处可拖动窗口、双击最大化。按钮与内容由 ShellWindow.Navigator.cs 填。
                宽 200:菜单 36 + 三个窗口按钮 44 要放得下。
            -->
            <Border x:Name="NavRail"
                    Grid.Column="1"
                    Width="200"
                    Background="{DynamicResource Aurora.Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Aurora.Brush.Hairline}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        窗口控制组的常规落点。专注态右栏让位,ChromeBar 被挪到专注页的页头上
                        (ShellWindow.Chrome.cs 的 PlaceChromeBar)。
                    -->
                    <ContentControl x:Name="NavChromeHost"
                                    Grid.Row="0"
                                    Height="{DynamicResource Aurora.Size.Tab}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Focusable="False">
            <!--
                UI-02.3:菜单 + 最小化 + 最大化还原 + 关闭,次序固定、任何形态都不删减。
                Grid.Column 只在回退时用得上:两处落点都找不到时挂回停靠区右上角。
            -->
            <StackPanel x:Name="ChromeBar"
                        Grid.Column="0"
                        Height="{DynamicResource Aurora.Size.Tab}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <!-- UI-04.4:退出专注,仅页面最大化时出现 -->
                <Button x:Name="ExitFocusButton"
                        Style="{StaticResource Aurora.ChromeIconButton}"
                        Visibility="Collapsed"
                        Click="OnExitFocusClick">
                    <Path Data="{StaticResource Aurora.Icon.ExitFocus}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>

                <!-- UI-03:折叠后的菜单,恒在三个窗口按钮左侧 -->
                <Button x:Name="MenuButton"
                        Style="{StaticResource Aurora.ChromeIconButton}"
                        Click="OnMenuButtonClick">
                    <Path Data="{StaticResource Aurora.Icon.Menu}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" />
                </Button>

                <Button x:Name="MinimizeButton"
                        Style="{StaticResource Aurora.WindowButton}"
                        ToolTip="最小化"
                        Click="OnMinimizeClick">
                    <Path Data="{StaticResource Aurora.Icon.Minimize}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>

                <Button x:Name="MaximizeButton"
                        Style="{StaticResource Aurora.WindowButton}"
                        ToolTip="最大化"
                        Click="OnMaximizeRestoreClick">
                    <Path x:Name="MaximizeIcon"
                          Data="{StaticResource Aurora.Icon.Maximize}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>

                <Button x:Name="CloseButton"
                        Style="{StaticResource Aurora.WindowButton.Close}"
                        ToolTip="关闭"
                        Click="OnCloseClick">
                    <Path Data="{StaticResource Aurora.Icon.Close}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>
            </StackPanel>
                    </ContentControl>

                    <!--
                        UI-05.3:错误计数(原状态栏)。1.20.0 从窗口控制组里拿出来放在搜索行:
                        右栏只有 200 宽,四个按钮之外再挤一块徽章会把关闭按钮挤出去。
                    -->
                    <DockPanel Grid.Row="1" Margin="6">
                        <Button x:Name="ErrorBadge"
                                DockPanel.Dock="Right"
                                Margin="6,0,0,0"
                                Style="{StaticResource Aurora.ErrorBadge}"
                                Visibility="Collapsed"
                                Click="OnErrorBadgeClick" />
                        <Button x:Name="NavSearchButton"
                                Style="{StaticResource Aurora.Button.Base}"
                                HorizontalContentAlignment="Left"
                                Content="搜索…" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavRailItems" Margin="6,0,6,6" />
                    </ScrollViewer>

                    <!-- 常用页面(REQ-UI-099):点一下在当前场景打开,按住拖出来落到蓝色停靠点上嵌入 -->
                    <Border Grid.Row="3"
                            Margin="6,0,6,0"
                            Padding="2,6,0,4"
                            BorderBrush="{DynamicResource Aurora.Brush.Hairline}"
                            BorderThickness="0,1,0,0">
                        <TextBlock x:Name="NavPagesHeader"
                                   Text="常用页面"
                                   FontFamily="{DynamicResource Aurora.Font.Family}"
                                   FontSize="{DynamicResource Aurora.Font.Small}"
                                   Foreground="{DynamicResource Aurora.Brush.TextSecondary}"
                                   ToolTip="没打开的页都在这里,按用得多少排。点一下在当前场景打开;按住拖出来,落到蓝色停靠点上嵌入" />
                    </Border>

                    <ScrollViewer Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="6,0,6,6">
                            <WrapPanel x:Name="NavPageItems" />
                            <TextBlock x:Name="NavPagesEmpty"
                                       Margin="2,2,0,0"
                                       Text="所有页面都已打开"
                                       Visibility="Collapsed"
                                       FontFamily="{DynamicResource Aurora.Font.Family}"
                                       FontSize="{DynamicResource Aurora.Font.Small}"
                                       Foreground="{DynamicResource Aurora.Brush.TextSecondary}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 导航器搜索浮层(REQ-UI-089):盖住整个窗体,点底板或 Esc 关闭 -->
            <Grid x:Name="NavOverlay"
                  Grid.ColumnSpan="2"
                  Panel.ZIndex="100"
                  Visibility="Collapsed">
                <Border x:Name="NavBackdrop"
                        Background="{DynamicResource Aurora.Brush.Canvas}"
                        Opacity="0.6" />
                <Border x:Name="NavCard"
                        Width="620"
                        Margin="0,72,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Style="{StaticResource Aurora.Suggest.Surface}">
                    <DockPanel Margin="{DynamicResource Aurora.Space.PadTight}">
                        <TextBox x:Name="NavQuery"
                                 DockPanel.Dock="Top"
                                 Style="{StaticResource Aurora.Segment.TextBox}" />
                        <TextBlock x:Name="NavHint"
                                   DockPanel.Dock="Bottom"
                                   Margin="4,6,4,0"
                                   Style="{StaticResource Aurora.Suggest.Hint}" />
                        <ListBox x:Name="NavResults"
                                 Margin="0,6,0,0"
                                 MaxHeight="420"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
