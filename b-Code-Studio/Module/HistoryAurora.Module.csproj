<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\AuroraVersion.props" />

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      DEC-008：界面回归模块形态，独立 exe 已退役。App 工程消失后不再有同名程序集，
      因此程序集短名取回 HistoryAurora——Shell 里 11 处 pack URI 形如
      `/HistoryAurora;component/Themes/AuroraTokens.xaml`，按程序集**短名**解析，
      名字对上就一行都不用改。
      （2026-08-20 曾因 App 与模块同名而解析到不含 .g.resources 的那个，
      AvalonDock 主题抛 IOException 且编译期毫无征兆——那正是同名的代价。）
    -->
    <AssemblyName>HistoryAurora</AssemblyName>
    <RootNamespace>HistoryAurora.Module</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      类库默认不把 NuGet 依赖落到输出目录；而模块的装载上下文只在**包目录内**解析依赖
      （宿主 ModuleLoadContext 按包路径解析，MH-02 槽内隔离），
      AvalonDock 不在包里就会在建窗时报 FileNotFoundException。
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS1573;CS1591</NoWarn>
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\2026-023-HistoryVulcan\z-Publish</HistoryVulcanPackageRoot>
    <HistoryVulcanHostRoot Condition="'$(HistoryVulcanHostRoot)' == ''">$(HistoryVulcanPackageRoot)\host</HistoryVulcanHostRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- 模块引用宿主运行库一律 Private=false：部署时由宿主提供，包里不带副本。 -->
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HistoryVulcan.Services">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Services.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      版本必须与宿主锁定的一致（宿主 Directory.Packages.props 锁 4.72.1）。
      不写版本时 NuGet 会解析到 3.4.0.4——那是 .NET Framework 目标的包，
      NU1701 只提示"可能不完全兼容"，而停靠布局的行为差异在编译期看不出来。
    -->
    <PackageReference Include="Dirkster.AvalonDock" Version="4.72.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.72.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      **一层一组，`Include` 里写死层目录**——这不是啰嗦，是两件事的唯一落点：

      一、`Link` 必须把层目录吃掉。XAML 的 pack URI 对应的资源名由 Link 路径决定，
      而 `%(RecursiveDir)` 只覆盖 `**` 之后的那一段：`Include` 写到 `2-Components\` 为止，
      `Themes\AuroraTokens.xaml` 的 RecursiveDir 就还是 `Themes\`，
      `/HistoryAurora;component/Themes/AuroraTokens.xaml` 一行不用改。
      若图省事写回 `..\Shell\**\*.xaml`，资源会落在 `2-components/themes/…`，
      运行期报 IOException「找不到资源」，编译期完全看不出来。

      二、这同时是分层门禁的第一道闸。新加一个没分层的顶层目录不会被任何一组捞到，
      整个目录直接不参与编译——比测试更早、更硬地拦住「就这一次」。
      加层要同时改这里、改 `LayerContractTests` 的层名表，两处都改才生效。
    -->
    <Compile Include="..\Shell\0-Neutral\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Shell\1-Base\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Shell\2-Components\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Shell\3-HostedPages\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Shell\4-Composition\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="..\Shell\2-Components\**\*.xaml" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="..\Shell\3-HostedPages\**\*.xaml" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="..\Shell\4-Composition\**\*.xaml" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AuroraBusinessComposition.cs" Link="AuroraBusinessComposition.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="module.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Contracts" />
    <InternalsVisibleTo Include="ModuleSmoke" />
  </ItemGroup>
</Project>
