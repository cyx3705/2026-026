<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\AuroraVersion.props" />

  <PropertyGroup>
    <!--
      2.1.0：Aurora 是装在宿主上的无界面服务，界面只在浏览器里（REQ-WEB-040/041）。
      仍目标 net8.0-windows 并开 UseWPF，只为一件事：给宿主的 IFrontend.UiContext 提供一条 STA Dispatcher，
      别的模块声明 RequiresUiThread 的指令要在上面建它们自己的 WPF 窗口。本程序集不含任何窗口与 XAML。
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HistoryAurora</AssemblyName>
    <RootNamespace>HistoryAurora.Module</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573;CS1591</NoWarn>
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\2026-023-HistoryVulcan\z-Publish</HistoryVulcanPackageRoot>
    <HistoryVulcanHostRoot Condition="'$(HistoryVulcanHostRoot)' == ''">$(HistoryVulcanPackageRoot)\host</HistoryVulcanHostRoot>
    <AuroraWebProject>$(MSBuildThisFileDirectory)..\..\b-Code-Web\HistoryAurora.Web.csproj</AuroraWebProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- 模块引用宿主运行库一律 Private=false：部署时由宿主提供，包里不带副本。 -->
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      一层一组，`Include` 里写死层目录：新加一个没分层的顶层目录不会被任何一组捞到，
      整个目录直接不参与编译。加层要同时改这里与 `LayerContractTests` 的层名表。
    -->
    <Compile Include="..\Shell\0-Neutral\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Shell\2-Components\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Shell\3-HostedPages\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AuroraBusinessComposition.cs" Link="AuroraBusinessComposition.cs" />
    <!-- 转给网页执行的界面指令的自描述（REQ-WEB-040）。 -->
    <EmbeddedResource Include="AuroraCommands.json" LogicalName="HistoryAurora.Module.AuroraCommands.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="module.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Contracts" />
    <InternalsVisibleTo Include="ModuleSmoke" />
  </ItemGroup>

  <!--
    Aurora Web 随包分发（REQ-WEB-041）：构建 b-Code-Web，把它的程序集放进输出目录的 web\。
    网页本体内嵌在 HistoryAurora.Web.dll 里（REQ-WEB-042），所以包里只多这四个文件。
    Web 工程目标 net8.0、不带 RID：这里清掉继承的 RID，并去掉宿主管线 `-f net8.0-windows` 传下来的全局 TargetFramework。
  -->
  <Target Name="BuildAuroraWeb" AfterTargets="Build">
    <MSBuild Projects="$(AuroraWebProject)" Targets="Restore" RemoveProperties="TargetFramework"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=;SelfContained=false;NuGetAudit=false;AuroraWebRestore=true" />
    <MSBuild Projects="$(AuroraWebProject)" Targets="Build" RemoveProperties="TargetFramework"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=;SelfContained=false;NuGetAudit=false" />
    <MSBuild Projects="$(AuroraWebProject)" Targets="GetTargetPath" RemoveProperties="TargetFramework"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=;SelfContained=false;NuGetAudit=false">
      <Output TaskParameter="TargetOutputs" PropertyName="AuroraWebAssembly" />
    </MSBuild>
    <PropertyGroup>
      <AuroraWebOutput>$([System.IO.Path]::GetDirectoryName('$(AuroraWebAssembly)'))\</AuroraWebOutput>
    </PropertyGroup>
    <ItemGroup>
      <AuroraWebFile Include="$(AuroraWebOutput)HistoryAurora.Web.dll;$(AuroraWebOutput)HistoryAurora.Web.exe;$(AuroraWebOutput)HistoryAurora.Web.deps.json;$(AuroraWebOutput)HistoryAurora.Web.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(AuroraWebFile)" DestinationFolder="$(OutDir)web" SkipUnchangedFiles="true" />
  </Target>
</Project>
