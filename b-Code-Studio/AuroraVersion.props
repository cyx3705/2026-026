<Project>
  <PropertyGroup>
    <HistoryAuroraVersion>1.5.2</HistoryAuroraVersion>
    <!-- Aurora 消费的 HistoryVulcan 正式宿主版本。这是宿主契约的唯一真源：
         发布脚本与质量门禁都从此读取，不再各自硬编码字面量。
         5.0.0 拆除宿主模块领域 SDK，冻结面只留注册器、总线和开发总线。 -->
    <MinimumHistoryVulcanVersion>5.0.0</MinimumHistoryVulcanVersion>
    <VersionPrefix>$(HistoryAuroraVersion)</VersionPrefix>
    <Version>$(HistoryAuroraVersion)</Version>
    <AssemblyVersion>$(HistoryAuroraVersion).0</AssemblyVersion>
    <FileVersion>$(HistoryAuroraVersion).0</FileVersion>
    <InformationalVersion>$(HistoryAuroraVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
